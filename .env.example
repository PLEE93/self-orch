# Copy to .env and fill. Never commit .env.

# GLM / z.ai coding API (OpenAI-compatible)
ZAI_API_KEY=
# GLM_API_KEY=          # alias for ZAI_API_KEY

# Grok / xAI
XAI_API_KEY=
# GROK_API_KEY=         # alias for XAI_API_KEY

# Optional OpenAI-compatible fallback
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# ACCOUNT AUTH TOKENS (no API key needed)
# ---------------------------------------------------------------------------
# You do NOT have to set any key above. If you are already logged in to a
# coding agent CLI, self-orch reuses that session directly:
#   Claude / Anthropic -> ~/.claude/.credentials.json  (claude setup-token)
#   GPT / OpenAI       -> Codex CLI login
#   Grok / xAI         -> Grok CLI login
# Run `self-orch doctor` to see which credential each vendor resolved and
# where it came from.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# DIFFICULTY TIERS -> MODELS
# ---------------------------------------------------------------------------
# Write model="tier1".."tier4" in a seat spec instead of a literal model id,
# and point each tier at whatever model YOU have access to. Literal model ids
# still work unchanged; tiers are an optional indirection.
#   tier1 -> mechanical/worker seats: mass work, cheap, wide, many in parallel
#   tier2 -> seats needing real understanding: analysis, judgment, synthesis
#   tier3 -> falsification/verification seats -- keep this a DIFFERENT model
#            family from tier1/tier2 so a verifier never grades its own family
#   tier4 -> the single heaviest step: plan, architecture, diagnosis
# SELF_ORCH_TIER1_MODEL=glm-5.3
# SELF_ORCH_TIER2_MODEL=claude-sonnet-4-5
# SELF_ORCH_TIER3_MODEL=gpt-5.1
# SELF_ORCH_TIER4_MODEL=claude-opus-4-5
